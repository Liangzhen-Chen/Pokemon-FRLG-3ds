diff --git a/platform/3ds/CMakeLists.txt b/platform/3ds/CMakeLists.txt
new file mode 100644
index 0000000..6563cf4
--- /dev/null
+++ b/platform/3ds/CMakeLists.txt
@@ -0,0 +1,93 @@
+cmake_minimum_required(VERSION 3.22)
+project(pokefirered_3ds C ASM)
+
+set(ROOT "${CMAKE_CURRENT_LIST_DIR}/../..")
+set(SDL_PREFIX "${ROOT}/../prefix")
+find_program(ARM_NONE_EABI_AS arm-none-eabi-as
+    HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin"
+    REQUIRED)
+find_program(ARM_NONE_EABI_LD arm-none-eabi-ld
+    HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin"
+    REQUIRED)
+find_program(ARM_NONE_EABI_OBJCOPY arm-none-eabi-objcopy
+    HINTS "$ENV{ARM_NONE_EABI_TOOLCHAIN}/bin"
+    REQUIRED)
+find_package(SDL2 CONFIG REQUIRED PATHS "${SDL_PREFIX}/lib/cmake/SDL2" NO_DEFAULT_PATH)
+
+file(GLOB_RECURSE GAME_C CONFIGURE_DEPENDS
+    "${ROOT}/src/*.c"
+    "${ROOT}/gflib/*.c")
+list(FILTER GAME_C EXCLUDE REGEX "\\.inc\\.c$")
+list(FILTER GAME_C EXCLUDE REGEX "/src/platform/voxel/")
+
+set(GENERATED_C)
+foreach(SOURCE IN LISTS GAME_C)
+    file(RELATIVE_PATH RELATIVE_SOURCE "${ROOT}" "${SOURCE}")
+    set(OUTPUT "${CMAKE_BINARY_DIR}/generated/${RELATIVE_SOURCE}")
+    get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
+    add_custom_command(
+        OUTPUT "${OUTPUT}"
+        COMMAND "${CMAKE_COMMAND}" -E make_directory "${OUTPUT_DIR}"
+        COMMAND /bin/sh -c "cd '${ROOT}' && '${CMAKE_C_COMPILER}' -E -std=gnu99 -iquote'${ROOT}/include' -iquote'${ROOT}/gflib' -I'${SDL_PREFIX}/include' -I'${CTR_ROOT}/include' -D__3DS__ -DNDEBUG -DNONMATCHING -DPORTABLE -DPLATFORM_SDL2 -DRENDERER_EASY_DRAW -DFIRERED=1 -DREVISION=1 -DENGLISH=1 -DMODERN=1 -DUBFIX '${SOURCE}' -o '${OUTPUT}.i' && '${ROOT}/tools/preproc/preproc' '${OUTPUT}.i' '${ROOT}/charmap.txt' > '${OUTPUT}'"
+        DEPENDS "${SOURCE}" "${ROOT}/tools/preproc/preproc" "${ROOT}/charmap.txt"
+        VERBATIM)
+    list(APPEND GENERATED_C "${OUTPUT}")
+endforeach()
+
+file(GLOB DATA_ASM CONFIGURE_DEPENDS "${ROOT}/data/*.s")
+file(GLOB SONG_ASM CONFIGURE_DEPENDS "${ROOT}/sound/songs/*.s" "${ROOT}/sound/songs/midi/*.s")
+set(GENERATED_ASM)
+set(SPECIAL_IDS "${CMAKE_BINARY_DIR}/generated/special_ids.inc")
+add_custom_command(
+    OUTPUT "${SPECIAL_IDS}"
+    COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_BINARY_DIR}/generated"
+    COMMAND /bin/sh -c "awk '/^[[:space:]]+def_special[[:space:]]/ { printf \".set SPECIAL_%s, %d\\n\", $2, id++ }' '${ROOT}/data/specials.inc' > '${SPECIAL_IDS}'"
+    DEPENDS "${ROOT}/data/specials.inc"
+    VERBATIM)
+foreach(SOURCE IN LISTS DATA_ASM SONG_ASM)
+    file(RELATIVE_PATH RELATIVE_SOURCE "${ROOT}" "${SOURCE}")
+    set(OUTPUT "${CMAKE_BINARY_DIR}/generated/${RELATIVE_SOURCE}.o")
+    get_filename_component(OUTPUT_DIR "${OUTPUT}" DIRECTORY)
+    if(SOURCE MATCHES "/sound/songs/")
+        add_custom_command(
+            OUTPUT "${OUTPUT}"
+            COMMAND "${CMAKE_COMMAND}" -E make_directory "${OUTPUT_DIR}"
+            COMMAND /bin/sh -c "sed -e 's/\\.4byte/\\.word/g;s/\\.2byte/\\.short/g' '${SOURCE}' > '${OUTPUT}.s' && '${ARM_NONE_EABI_AS}' -march=armv6k -I'${ROOT}/sound' -o '${OUTPUT}' '${OUTPUT}.s'"
+            DEPENDS "${SOURCE}"
+            VERBATIM)
+    else()
+        add_custom_command(
+            OUTPUT "${OUTPUT}"
+            COMMAND "${CMAKE_COMMAND}" -E make_directory "${OUTPUT_DIR}"
+        COMMAND /bin/bash -o pipefail -c "cd '${ROOT}' && { printf \".include \\\"${SPECIAL_IDS}\\\"\\n\"; '${ROOT}/tools/preproc/preproc' '${SOURCE}' '${ROOT}/charmap.txt' | /usr/bin/clang -E -x c -I'${ROOT}/include' -DPORTABLE -DUBFIX - | '${ROOT}/tools/preproc/preproc' -ie '${SOURCE}' '${ROOT}/charmap.txt'; } > '${OUTPUT}.s' && '${ARM_NONE_EABI_AS}' -march=armv6k --defsym FIRERED=1 --defsym REVISION=1 --defsym ENGLISH=1 --defsym MODERN=1 -I'${ROOT}' -I'${ROOT}/sound' -o '${OUTPUT}' '${OUTPUT}.s'"
+            DEPENDS "${SOURCE}" "${ROOT}/tools/preproc/preproc" "${ROOT}/charmap.txt" "${SPECIAL_IDS}"
+            VERBATIM)
+    endif()
+    list(APPEND GENERATED_ASM "${OUTPUT}")
+endforeach()
+
+set(GAME_DATA_OBJECT "${CMAKE_BINARY_DIR}/generated/game_data.o")
+add_custom_command(
+    OUTPUT "${GAME_DATA_OBJECT}"
+    COMMAND "${ARM_NONE_EABI_LD}" -r -o "${GAME_DATA_OBJECT}.tmp" ${GENERATED_ASM}
+    COMMAND "${ARM_NONE_EABI_OBJCOPY}" --rename-section .rodata=.data,alloc,load,data,contents "${GAME_DATA_OBJECT}.tmp" "${GAME_DATA_OBJECT}"
+    DEPENDS ${GENERATED_ASM}
+    VERBATIM)
+set_source_files_properties("${GAME_DATA_OBJECT}" PROPERTIES GENERATED TRUE EXTERNAL_OBJECT TRUE)
+
+add_executable(firered_3ds ${GENERATED_C} "${GAME_DATA_OBJECT}")
+set_property(TARGET firered_3ds PROPERTY C_STANDARD 99)
+target_include_directories(firered_3ds PRIVATE
+    "${ROOT}"
+    "${ROOT}/sound"
+    "${SDL_PREFIX}/include")
+target_compile_definitions(firered_3ds PRIVATE
+    NONMATCHING PORTABLE PLATFORM_SDL2 RENDERER_EASY_DRAW FIRERED=1 REVISION=1 ENGLISH=1 MODERN=1 UBFIX)
+target_compile_options(firered_3ds PRIVATE
+    -O3
+    -fno-builtin
+    -Wno-implicit-function-declaration
+    -Wno-int-conversion
+    "SHELL:-iquote '${ROOT}/include'"
+    "SHELL:-iquote '${ROOT}/gflib'")
+target_link_libraries(firered_3ds PRIVATE SDL2::SDL2main SDL2::SDL2 m)
