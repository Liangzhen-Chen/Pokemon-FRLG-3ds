+        SDL_Log("Invalid save file size or seek failure: %s (%ld bytes)", path, fileSize);
+        CloseSaveFile();
+        return false;
+    }
+    size_t bytesRead = fread(FLASH_BASE, 1, sizeof(FLASH_BASE), sSaveFile);
+    if (bytesRead != sizeof(FLASH_BASE))
+    {
+        SDL_Log("Unable to read complete save file %s (%zu of %zu bytes)",
+                path, bytesRead, sizeof(FLASH_BASE));
