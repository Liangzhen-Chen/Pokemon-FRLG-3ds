+    if (sSaveFile == NULL && errno != ENOENT)
+    {
+        SDL_Log("Unable to open save file %s: %s", path, strerror(errno));
+        return false;
+    }
+    if (sSaveFile == NULL)
+    {
+        memset(FLASH_BASE, 0xFF, sizeof(FLASH_BASE));
+        // A missing save is valid only if its erased image can be written.
+        return Platform_CommitSaveFile() != FALSE;
+    }
+    if (fseek(sSaveFile, 0, SEEK_END) != 0)
+    {
+        SDL_Log("Unable to seek save file %s: %s", path, strerror(errno));
+        CloseSaveFile();
+        return false;
+    }
+    long fileSize = ftell(sSaveFile);
+    if (fileSize != (long)sizeof(FLASH_BASE) || fseek(sSaveFile, 0, SEEK_SET) != 0)
